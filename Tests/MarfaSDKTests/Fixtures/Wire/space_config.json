{
  "enforcement": {
    "strict_mode": { "types": ["core.note"] },
    "source_allowlist": { "types": ["core.task"], "sources": ["sync-agent"] },
    "source_filter": { "types": ["core.bookmark"], "sources": ["bulk-importer"] }
  },
  "audit_retention_days": 30,
  "event_log_retention_hours": 72,
  "trash_retention_days": 14,
  "activity_retention_days": 7,
  "max_event_hop_budget": 3
}
